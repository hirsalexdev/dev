# Pflicht in Produktion: ohne festen Wert werden alle Download-Links bei jedem
# Neustart ungültig. Erzeugen mit: openssl rand -hex 32
SIGNING_SECRET=

PORT=8080
HOST=0.0.0.0
# Auf true setzen, wenn ein Reverse Proxy (nginx, Caddy, Fly, Railway) davor steht.
TRUST_PROXY=false

# Reihenfolge der Resolver-Kette. Der erste, der Medien liefert, gewinnt.
RESOLVERS=embed,graphql,apiv1,ytdlp

# Der wichtigste Schalter für Cloud-Deployments. Instagram blockt Datacenter-IPs
# (AWS, GCP, Hetzner, DigitalOcean) teils ab der ersten Anfrage. Ein Residential-
# oder Mobile-Proxy ist der Unterschied zwischen "funktioniert" und "429".
# Beispiel: http://user:pass@proxy.example.com:8000
PROXY_URL=

# Optionale eingeloggte Session. Erhöht die Trefferquote deutlich, kann aber zur
# Sperrung des Kontos führen. Niemals das Hauptkonto verwenden.
IG_SESSIONID=
IG_DS_USER_ID=
IG_CSRFTOKEN=

# GraphQL doc_ids rotieren alle zwei bis vier Wochen. Hier ohne Code-Änderung
# nachziehen (siehe README, Abschnitt "Wenn es kaputt geht").
IG_DOC_IDS=8845758582119845,27130156389949648,10015901848480474

# Optionaler Fallback. yt-dlp wird von der Community gepflegt und fängt die
# meisten Instagram-Änderungen ab, bevor dieses Repo es tut.
YTDLP_BINARY=yt-dlp
YTDLP_TIMEOUT_MS=25000

REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=3

CACHE_TTL_SECONDS=1200
CACHE_MAX_ENTRIES=500

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=20

DOWNLOAD_TTL_SECONDS=1800
MAX_DOWNLOAD_BYTES=536870912
ALLOWED_MEDIA_HOSTS=cdninstagram.com,fbcdn.net,instagram.com
